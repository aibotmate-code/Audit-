<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SMASH BOX Cricket — Rapid Business Audit | Intellical Labs</title>
<link href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,300;0,400;0,600;0,700;0,800;0,900;1,300&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --black: #0a0a0a;
    --black-2: #111111;
    --black-3: #1a1a1a;
    --gold: #FFC857;
    --gold-dim: #CC9B2A;
    --gold-glow: rgba(255,200,87,0.15);
    --orange: #FF8C00;
    --white: #F5F5F5;
    --white-dim: rgba(245,245,245,0.6);
    --white-faint: rgba(245,245,245,0.08);
    --border: rgba(255,200,87,0.2);
    --red: #FF4444;
    --green: #4CAF79;
    --amber: #FFB347;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4, .exo { font-family: 'Exo 2', sans-serif; }

  /* ═══ PRINT / PAGE ═══ */
  @media print {
    body { background: white; color: #111; }
    .page { box-shadow: none; page-break-after: always; }
  }

  /* ═══ LAYOUT ═══ */
  .report-wrap { max-width: 900px; margin: 0 auto; padding: 0; }

  .page {
    background: var(--black);
    min-height: 1120px;
    position: relative;
    overflow: hidden;
    margin-bottom: 2px;
  }

  /* ═══ COVER PAGE ═══ */
  .cover {
    background: linear-gradient(160deg, #0a0a0a 0%, #111 40%, #1a1200 100%);
    display: flex;
    flex-direction: column;
    min-height: 1120px;
    padding: 0;
  }

  .cover-header {
    background: linear-gradient(90deg, #0a0a0a, #1a1200);
    border-bottom: 1px solid var(--border);
    padding: 28px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #FFC857, #FF8C00);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Exo 2', sans-serif;
    font-weight: 900;
    font-size: 20px;
    color: #0a0a0a;
    letter-spacing: -1px;
    flex-shrink: 0;
  }

  .brand-text h2 {
    font-family: 'Exo 2', sans-serif;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--white);
  }

  .brand-text h2 span { color: var(--gold); }

  .brand-text p {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--white-dim);
    text-transform: uppercase;
    margin-top: 2px;
  }

  .cover-badge {
    background: var(--gold-glow);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
  }

  .cover-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 48px;
    position: relative;
  }

  .cover-bg-grid {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(255,200,87,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,200,87,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  .cover-eyebrow {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cover-eyebrow::before {
    content: '';
    display: block;
    width: 30px;
    height: 1px;
    background: var(--gold);
  }

  .cover-title {
    font-family: 'Exo 2', sans-serif;
    font-size: 58px;
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -2px;
    color: var(--white);
    margin-bottom: 16px;
  }

  .cover-title span {
    background: linear-gradient(90deg, #FFC857, #FF8C00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cover-subtitle {
    font-size: 15px;
    color: var(--white-dim);
    font-weight: 300;
    letter-spacing: 0.5px;
    max-width: 480px;
    line-height: 1.7;
    margin-bottom: 48px;
  }

  .cover-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    max-width: 560px;
    margin-bottom: 60px;
  }

  .cover-meta-item {
    background: rgba(255,200,87,0.04);
    padding: 16px 20px;
  }

  .cover-meta-item .label {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white-dim);
    margin-bottom: 6px;
  }

  .cover-meta-item .value {
    font-family: 'Exo 2', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: var(--white);
  }

  .cover-score-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 60px;
  }

  .cover-score-bar .score-label {
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--white-dim);
    min-width: 180px;
  }

  .score-track {
    flex: 1;
    max-width: 300px;
    height: 6px;
    background: rgba(255,255,255,0.08);
    border-radius: 3px;
    overflow: hidden;
  }

  .score-fill {
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--gold-dim), var(--gold));
  }

  .score-num {
    font-family: 'Exo 2', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--gold);
    min-width: 50px;
  }

  .cover-footer {
    background: rgba(0,0,0,0.6);
    border-top: 1px solid var(--border);
    padding: 20px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cover-footer .fn {
    font-size: 11px;
    color: var(--white-dim);
    letter-spacing: 1px;
  }

  .cover-footer .fn span { color: var(--gold); }

  /* ═══ INNER PAGES ═══ */
  .inner-page {
    background: var(--black);
    padding: 0;
    min-height: 1120px;
  }

  .page-header {
    background: linear-gradient(90deg, var(--black-2), var(--black));
    border-bottom: 1px solid var(--border);
    padding: 18px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .page-header .brand-mini {
    font-family: 'Exo 2', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 1px;
  }

  .page-header .section-label {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white-dim);
  }

  .page-content { padding: 40px 48px; }

  /* ═══ SECTION HEADERS ═══ */
  .section-num {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 6px;
  }

  .section-title {
    font-family: 'Exo 2', sans-serif;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--white);
    margin-bottom: 4px;
  }

  .section-desc {
    font-size: 13px;
    color: var(--white-dim);
    margin-bottom: 32px;
    max-width: 560px;
  }

  .gold-divider {
    width: 40px;
    height: 2px;
    background: linear-gradient(90deg, var(--gold), transparent);
    margin-bottom: 32px;
  }

  /* ═══ INSIGHT BOX ═══ */
  .insight-box {
    background: var(--gold-glow);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    border-radius: 8px;
    padding: 20px 24px;
    margin-bottom: 24px;
  }

  .insight-box .insight-label {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .insight-box p {
    font-size: 14px;
    color: var(--white);
    line-height: 1.7;
    font-weight: 300;
  }

  .insight-box p strong { color: var(--gold); font-weight: 600; }

  /* ═══ SCORE CARDS ═══ */
  .score-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 32px;
  }

  .score-card {
    background: var(--black-2);
    border: 1px solid rgba(255,200,87,0.12);
    border-radius: 10px;
    padding: 20px;
  }

  .score-card .sc-label {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white-dim);
    margin-bottom: 12px;
  }

  .score-card .sc-value {
    font-family: 'Exo 2', sans-serif;
    font-size: 32px;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 10px;
  }

  .sc-bar {
    height: 4px;
    background: rgba(255,255,255,0.08);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .sc-bar-fill {
    height: 100%;
    border-radius: 2px;
  }

  .sc-note {
    font-size: 10px;
    color: var(--white-dim);
  }

  .score-high .sc-value { color: var(--green); }
  .score-high .sc-bar-fill { background: linear-gradient(90deg, #2d7a50, var(--green)); }

  .score-mid .sc-value { color: var(--gold); }
  .score-mid .sc-bar-fill { background: linear-gradient(90deg, var(--gold-dim), var(--gold)); }

  .score-low .sc-value { color: var(--red); }
  .score-low .sc-bar-fill { background: linear-gradient(90deg, #882222, var(--red)); }

  .score-amber .sc-value { color: var(--amber); }
  .score-amber .sc-bar-fill { background: linear-gradient(90deg, #8B5E00, var(--amber)); }

  /* ═══ TWO COL ═══ */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
  }

  .three-col {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }

  /* ═══ STAT BLOCK ═══ */
  .stat-block {
    background: var(--black-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
  }

  .stat-block .stat-num {
    font-family: 'Exo 2', sans-serif;
    font-size: 36px;
    font-weight: 900;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-block .stat-label {
    font-size: 11px;
    color: var(--white-dim);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .stat-block .stat-context {
    font-size: 12px;
    color: var(--white-dim);
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,0.06);
    line-height: 1.5;
  }

  /* ═══ LIST ROWS ═══ */
  .row-list { margin-bottom: 24px; }

  .row-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .row-item:last-child { border-bottom: none; }

  .row-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-top: 5px;
    flex-shrink: 0;
  }

  .row-item .ri-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 3px;
  }

  .row-item .ri-desc {
    font-size: 12px;
    color: var(--white-dim);
    line-height: 1.5;
  }

  /* ═══ SWOT ═══ */
  .swot-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 32px;
  }

  .swot-cell {
    background: var(--black-2);
    padding: 24px;
  }

  .swot-cell .swot-label {
    font-family: 'Exo 2', sans-serif;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .swot-cell .swot-item {
    font-size: 12px;
    color: var(--white-dim);
    padding: 6px 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.4;
  }

  .swot-cell .swot-item::before {
    content: '→';
    flex-shrink: 0;
    font-size: 11px;
    margin-top: 1px;
  }

  .swot-s .swot-label { color: var(--green); }
  .swot-w .swot-label { color: var(--red); }
  .swot-o .swot-label { color: var(--gold); }
  .swot-t .swot-label { color: var(--amber); }

  /* ═══ BAR CHART ═══ */
  .bar-chart { margin-bottom: 32px; }

  .bar-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  .bar-row-label {
    font-size: 12px;
    color: var(--white-dim);
    min-width: 180px;
    text-align: right;
    flex-shrink: 0;
  }

  .bar-track {
    flex: 1;
    height: 28px;
    background: rgba(255,255,255,0.05);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .bar-fill {
    height: 100%;
    border-radius: 4px;
    display: flex;
    align-items: center;
    padding-left: 12px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Exo 2', sans-serif;
  }

  .bar-smashbox { background: linear-gradient(90deg, #CC9B2A, #FFC857); color: #0a0a0a; }
  .bar-comp1 { background: rgba(255,255,255,0.12); color: var(--white-dim); }
  .bar-comp2 { background: rgba(255,255,255,0.08); color: var(--white-dim); }
  .bar-comp3 { background: rgba(255,255,255,0.06); color: var(--white-dim); }

  /* ═══ OPPORTUNITY TABLE ═══ */
  .opp-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 32px;
  }

  .opp-table th {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white-dim);
    padding: 10px 16px;
    text-align: left;
    background: var(--black-2);
    border-bottom: 1px solid var(--border);
  }

  .opp-table td {
    padding: 12px 16px;
    font-size: 12px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    vertical-align: middle;
  }

  .opp-table tr:hover td { background: var(--white-faint); }

  .opp-table .td-name { color: var(--white); font-weight: 500; }
  .opp-table .td-dim { color: var(--white-dim); }

  .tag {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 10px;
    letter-spacing: 1px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .tag-high { background: rgba(76,175,121,0.15); color: var(--green); border: 1px solid rgba(76,175,121,0.3); }
  .tag-med { background: rgba(255,200,87,0.12); color: var(--gold); border: 1px solid var(--border); }
  .tag-low { background: rgba(255,68,68,0.1); color: var(--red); border: 1px solid rgba(255,68,68,0.3); }
  .tag-crit { background: rgba(255,140,0,0.12); color: var(--orange); border: 1px solid rgba(255,140,0,0.3); }

  /* ═══ ACTION PLAN ═══ */
  .action-phase {
    margin-bottom: 28px;
  }

  .action-phase-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .phase-badge {
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 700;
    font-family: 'Exo 2', sans-serif;
  }

  .phase-now { background: rgba(76,175,121,0.15); color: var(--green); border: 1px solid rgba(76,175,121,0.3); }
  .phase-30 { background: rgba(255,200,87,0.12); color: var(--gold); border: 1px solid var(--border); }
  .phase-90 { background: rgba(255,140,0,0.12); color: var(--orange); border: 1px solid rgba(255,140,0,0.3); }

  .phase-title {
    font-family: 'Exo 2', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--white);
  }

  .action-item {
    background: var(--black-2);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 10px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: start;
  }

  .action-item .ai-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 4px;
  }

  .action-item .ai-desc {
    font-size: 12px;
    color: var(--white-dim);
    line-height: 1.5;
  }

  .action-item .ai-outcome {
    font-size: 11px;
    color: var(--gold);
    margin-top: 8px;
  }

  /* ═══ CLOSING PAGE ═══ */
  .closing-page {
    background: linear-gradient(160deg, #0a0a0a 0%, #1a1200 100%);
    display: flex;
    flex-direction: column;
    min-height: 700px;
  }

  .closing-body {
    flex: 1;
    padding: 60px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  .closing-statement {
    font-family: 'Exo 2', sans-serif;
    font-size: 36px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: var(--white);
    max-width: 600px;
    margin-bottom: 24px;
  }

  .closing-statement span {
    background: linear-gradient(90deg, #FFC857, #FF8C00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .closing-sub {
    font-size: 15px;
    color: var(--white-dim);
    max-width: 520px;
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .cta-pill {
    background: linear-gradient(90deg, #FFC857, #FF8C00);
    color: #0a0a0a;
    font-family: 'Exo 2', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 12px 28px;
    border-radius: 30px;
    text-decoration: none;
  }

  .contact-line {
    font-size: 13px;
    color: var(--white-dim);
  }

  .contact-line span { color: var(--gold); }

  .closing-footer {
    background: var(--black-2);
    border-top: 1px solid var(--border);
    padding: 20px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .closing-footer .cf-brand {
    font-family: 'Exo 2', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: var(--gold);
  }

  .closing-footer .cf-detail {
    font-size: 11px;
    color: var(--white-dim);
  }

  /* ═══ RADAR CHART ═══ */
  .radar-wrap {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 32px;
  }

  .radar-legend {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .radar-leg-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .radar-leg-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .radar-leg-label {
    font-size: 12px;
    color: var(--white-dim);
    flex: 1;
  }

  .radar-leg-val {
    font-family: 'Exo 2', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: var(--white);
  }

  /* ═══ CALLOUT ═══ */
  .callout {
    background: linear-gradient(135deg, rgba(255,200,87,0.08), rgba(255,140,0,0.04));
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
  }

  .callout::before {
    content: '"';
    position: absolute;
    top: -10px;
    right: 20px;
    font-family: 'Exo 2', sans-serif;
    font-size: 100px;
    font-weight: 900;
    color: rgba(255,200,87,0.08);
    line-height: 1;
  }

  .callout p {
    font-family: 'Exo 2', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--white);
